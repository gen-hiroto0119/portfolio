{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "mkdir -p dist/client && vite dev",
    "build": "vite build --config vite.client.config.ts && vite build",
    "start": "node .output/server/index.mjs",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test lib/content/calendar-date.test.ts lib/og/title.test.ts",
    "test:publishing": "tsx --test lib/publishing/*.test.ts lib/content/index.test.ts lib/content/rss.test.ts",
    "test:delivery": "node scripts/delivery/run.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/noto-sans-jp": "^5.2.10",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/blob": "2.8.1",
    "@vercel/functions": "^3.10.2",
    "@vercel/speed-insights": "^2.0.0",
    "highlight.js": "11.12.0",
    "hono": "^4.13.13",
    "lowlight": "3.3.0",
    "nitro": "^3.0.260610-beta",
    "rollup": "^4.64.12",
    "satori": "^0.63.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.6",
    "workflow": "5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "undici": "6.29.0"
  }
