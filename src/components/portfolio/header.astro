---
import ThemeToggle from "./theme-toggle.astro";
---

<header class="header">
  <a href="/" class="homeLink">HirotoFurugen</a>
  <div class="actions">
    <nav aria-label="メインナビゲーション">
      <a href="/">Home</a>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 40px;
    margin-bottom: var(--gap);
  }
  .homeLink {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  @media (max-width: 599px) {
    .header {
      height: 44px;
    }
    .homeLink {
      min-height: 44px;
    }
    .actions {
      gap: 8px;
    }
    .actions nav a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
      padding: 0;
    }
  }
</style>
