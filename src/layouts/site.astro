---
import { Moon, Sun } from 'lucide-react';
import { site } from '@/lib/site';
import styles from '@/components/portfolio/portfolio.module.css';
import '../styles/global.css';
interface Props { title: string; description?: string; image?: string; articleDate?: string; noindex?: boolean }
const { title, description = site.description, image = '/opengraph-image', articleDate, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const blog = Astro.url.pathname.startsWith('/blog');
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/portfolio/fonts/Geist-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/portfolio/fonts/Geist-SemiBold.ttf" as="font" type="font/ttf" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="google-site-verification" content="ssWfIeurI-ISfNLYHK1mlYeqDZzqYm2nfiBx17FY1FA" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/icon.png" type="image/png" sizes="256x256" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={articleDate ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url).href} />
    {articleDate && <meta property="article:published_time" content={articleDate} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, site.url).href} />
    <script is:inline>try{var t=localStorage.getItem('portfolio-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch{}</script>
    {process.env.VERCEL_ENV === 'production' && <>
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HPL2D9ZG54"></script>
      <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-HPL2D9ZG54');</script>
    </>}
  </head>
  <body class="isolate flex min-h-screen flex-col bg-background font-sans text-foreground antialiased">
    <div class={styles.site}>
      <a href="#main" class={styles.skipLink}>本文へスキップ</a>
      <div class={styles.container}>
        <header class={styles.header}>
          <a href="/" class={styles.homeLink}>HirotoFurugen</a>
          <div class={styles.headerActions}>
            <nav aria-label="メインナビゲーション"><a href={blog ? '/' : '/blog'}>{blog ? 'Home' : 'Blog'}</a></nav>
            <button type="button" class={styles.themeToggle} data-theme-toggle aria-label="配色を切り替える">
              <Moon size={16} className={styles.lightIcon} aria-hidden="true" />
              <Sun size={16} className={styles.darkIcon} aria-hidden="true" />
            </button>
          </div>
        </header>
        <slot />
        <footer class={styles.footer}>
          <nav aria-label="ソーシャルリンク" class={styles.socials}>
            <a href={site.socials.github} aria-label="GitHub"><img src="/portfolio/github.svg" width="16" height="16" alt="" /></a>
            <a href={site.socials.linkedin} aria-label="LinkedIn"><img src="/portfolio/linkedin.svg" width="16" height="16" alt="" /></a>
          </nav>
          <span>HirotoFurugen</span>
        </footer>
      </div>
    </div>
    <script>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('portfolio-theme', next); } catch { /* Storage is optional. */ }
      });
    </script>
    <script is:inline defer src="/_vercel/speed-insights/script.js" data-sdkn="@vercel/speed-insights/astro"></script>
  </body>
</html>
