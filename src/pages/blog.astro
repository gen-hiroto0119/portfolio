---
import Layout from "@/layouts/layout.astro";
import PostList from "@/components/portfolio/post-list.astro";
import { getAllPosts } from "@/feature/posts/service";

const posts = await getAllPosts();
---

<Layout path="/blog" title="Blog" description="開発やデザインについて、考えたこと。">
  <main id="main" class="portfolio-main">
    <header class="portfolio-blogHeading">
      <h1>Blog</h1>
    </header>
    <section class="portfolio-section" aria-label="記事一覧">
      <PostList posts={posts} />
    </section>
  </main>
</Layout>
