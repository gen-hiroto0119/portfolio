---
import Layout from "@/layouts/layout.astro";
import PostList from "@/components/portfolio/post-list.astro";
import { getAllPosts } from "@/feature/posts/service";

const posts = await getAllPosts();

const experience = [
  {
    company: "CyberAgent",
    role: "Software Engineer · Intern",
    date: "2026.07 — 現在",
    logo: "cyberagent-logo-clean",
  },
  {
    company: "Google",
    role: "Campus Ambassador",
    date: "2026.04 — 現在",
    logo: "google-logo",
  },
  {
    company: "CyberAgent",
    role: "Backend Engineer · Intern",
    date: "2026.02 — 2026.03",
    logo: "cyberagent-logo-clean",
  },
  {
    company: "LayerX",
    role: "Product Manager · Intern",
    date: "2025.08 — 2026.07",
    logo: "layerx-logo",
  },
];

const technology = (name: string, logo: string) => ({ name, logo });
const stack = [
  technology("React", "react"),
  technology("Next.js", "nextjs"),
  technology("Deno", "deno"),
  technology("Swift", "swift"),
];
---

<Layout path="/">
  <main id="main" class="portfolio-main">
    <section class="portfolio-intro" lang="en" aria-label="Profile">
      <p>
        I'm a <strong>product engineer</strong> based in Tokyo, and I love <strong
          >Product Design</strong
        >. I'm currently working as an engineer while attending university.
      </p>
      <p>
        My main focus is on <strong>frontend</strong> and <strong
          >native development</strong
        >. I primarily use {
          stack.map((item, index) => (
            <>
              <span class="portfolio-technology"><img src={`/portfolio/${item.logo}-logo.svg`} width="15" height="15" alt="" />{item.name}</span>{index < stack.length - 2 ? ", " : index === stack.length - 2 ? ", and " : "."}
            </>
          ))
        }
      </p>
      <p>
        Lately, I've been drawn to <span class="portfolio-technology"
          ><img src="/portfolio/rust-logo.svg" width="15" height="15" alt="" />Rust</span
        > and am building a <strong>macOS application</strong> with <strong
          >GPUI</strong
        >.
      </p>
    </section>
    <section class="portfolio-section" aria-labelledby="work-title">
      <h2 id="work-title">Work</h2>
      <ul class="portfolio-experience">
        {
          experience.map((job) => (
            <li class="portfolio-experienceRow">
              <span class="portfolio-job">
                <img src={`/portfolio/${job.logo}.svg`} width="16" height="16" alt="" />
                <span lang="en">
                  {job.company} <span class="portfolio-secondary">~ {job.role}</span>
                </span>
              </span>
              <span class="portfolio-date">{job.date}</span>
            </li>
          ))
        }
      </ul>
    </section>
    <section class="portfolio-section" aria-labelledby="edu-title">
      <h2 id="edu-title">Edu</h2>
      <div class="portfolio-experienceRow" lang="en">
        <span>
          Hosei University <span class="portfolio-secondary">~ Geography</span>
        </span>
        <span class="portfolio-date">2024.04 — 2028.03 (Expected)</span>
      </div>
    </section>
    <section
      class="portfolio-section portfolio-projects"
      aria-labelledby="projects-title"
    >
      <h2 id="projects-title">Projects</h2>
    </section>
    <section class="portfolio-section" aria-labelledby="blog-title">
      <div class="portfolio-sectionHeading">
        <h2 id="blog-title">Blog</h2>
        <a href="/blog">記事一覧を見る ↗</a>
      </div>
      <PostList posts={posts.slice(0, 3)} />
    </section>
  </main>
</Layout>
