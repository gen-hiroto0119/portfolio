---
import Layout from "@/layouts/layout.astro";
import Hero from "@/components/portfolio/hero.astro";
import PostList from "@/components/portfolio/post-list.astro";
import { getAllPosts } from "@/feature/posts/service";

const posts = await getAllPosts();

const experience = [
  {
    company: "CyberAgent",
    role: "Software Engineer · Intern",
    date: "2026.07 — 現在",
    logo: "cyberagent-logo-clean",
  },
  {
    company: "Google",
    role: "Campus Ambassador",
    date: "2026.04 — 現在",
    logo: "google-logo",
  },
  {
    company: "CyberAgent",
    role: "Backend Engineer · Intern",
    date: "2026.02 — 2026.03",
    logo: "cyberagent-logo-clean",
  },
  {
    company: "LayerX",
    role: "Product Manager · Intern",
    date: "2025.08 — 2026.07",
    logo: "layerx-logo",
  },
];
---

<Layout path="/">
  <Hero />
  <section class="portfolio-section" aria-labelledby="work-title">
    <h2 id="work-title">Work</h2>
    <ul class="experience">
      {
        experience.map((job) => (
          <li class="row">
            <span class="job">
              <img src={`/portfolio/${job.logo}.svg`} width="16" height="16" alt="" />
              <span lang="en">
                {job.company} <span class="portfolio-secondary">~ {job.role}</span>
              </span>
            </span>
            <span class="date">{job.date}</span>
          </li>
        ))
      }
    </ul>
  </section>
  <section class="portfolio-section" aria-labelledby="edu-title">
    <h2 id="edu-title">Edu</h2>
    <div class="row" lang="en">
      <span>
        Hosei University <span class="portfolio-secondary">~ Geography</span>
      </span>
      <span class="date">2024.04 — 2028.03 (Expected)</span>
    </div>
  </section>
  <section class="portfolio-section projects" aria-labelledby="projects-title">
    <h2 id="projects-title">Projects</h2>
  </section>
  <section id="blog" class="portfolio-section" aria-labelledby="blog-title">
    <h2 id="blog-title">Blog</h2>
    <PostList posts={posts} />
  </section>
</Layout>

<style>
  .experience {
    display: flex;
    flex-direction: column;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    line-height: 20px;
    padding-block: 4px;
  }
  .job {
    display: flex;
    align-items: baseline;
    gap: 6px;
    min-width: 0;
  }
  .job img {
    width: 16px;
    height: 16px;
    object-fit: contain;
    align-self: center;
    flex-shrink: 0;
  }
  .date {
    color: var(--muted-foreground);
    white-space: nowrap;
    font-size: 12px;
  }
  .projects {
    min-height: 53px;
  }
  @media (min-width: 600px) {
    .row {
      font-size: 13px;
    }
  }
  @media (max-width: 599px) {
    .experience {
      gap: 16px;
    }
    .row {
      flex-direction: column;
      gap: 8px;
    }
    .date {
      font-size: 14px;
    }
  }
</style>
