{
  "extends": "nitro/tsconfig",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [{ "name": "workflow" }]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "nitro.config.ts"],
  "exclude": ["node_modules", ".output", ".vercel"]
}
